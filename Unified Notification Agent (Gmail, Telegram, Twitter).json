{
  "name": "Unified Notification Agent (Gmail, Telegram, Twitter)",
  "nodes": [
    {
      "parameters": {
        "content": "## Unified Notification Agent\n\nPulls new activity from Gmail, Telegram, and Twitter/X, normalizes each into a common shape:\n`{ platform, title, message, timestamp, link }`\nthen forwards everything as one alert email via Gmail.\n\n**Before running:**\n1. Attach your credentials to every node below (Gmail OAuth2, Telegram Bot API, Twitter Bearer Token).\n2. Set your real email address in the final 'Send Unified Alert' node.\n3. Replace `1229005646625820673` with your correct Twitter User ID in the HTTP Request node if needed.",
        "height": 300,
        "width": 420
      },
      "id": "323257a7-556d-4ebb-bc64-0299209ce15c",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -512,
        16
      ]
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {},
        "options": {}
      },
