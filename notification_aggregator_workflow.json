{
  "name": "Unified Notification Agent (Gmail, Telegram, Twitter, Instagram)",
  "nodes": [
    {
      "id": "sticky_overview",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-400, -420],
      "parameters": {
        "width": 420,
        "height": 300,
        "content": "## Unified Notification Agent\n\nPulls new activity from Gmail, Telegram, Twitter/X and Instagram, normalizes each into a common shape:\n`{ platform, title, message, timestamp, link }`\nthen forwards everything as one alert to a single Telegram chat.\n\n**Before running:**\n1. Attach your own credentials to every node below (Gmail OAuth2, Telegram Bot API, Twitter Bearer Token, Instagram/Meta Graph API token).\n2. Set the Telegram `chatId` in the final 'Send Unified Alert' node.\n3. Set your Instagram Business Account ID in the 'Get Instagram Mentions' node."
      }
    },
    {
      "id": "sticky_linkedin",
      "name": "Why LinkedIn Isn't Here",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-400, -80],
      "parameters": {
        "width": 420,
        "height": 220,
        "color": 4,
        "content": "## LinkedIn — not included\n\nLinkedIn does not expose a public API for personal notifications (mentions, connection requests, messages, feed activity). Only company-page posting is available to approved apps, and only for content you publish yourself.\n\n**Workaround:** LinkedIn's own mobile/email notifications are the only real-time option; there is no legitimate way to pull them into n8n."
      }
    },
    {
      "id": "sticky_snapchat",
      "name": "Why Snapchat Isn't Here",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-400, 180],
      "parameters": {
        "width": 420,
        "height": 220,
        "color": 4,
        "content": "## Snapchat — not possible\n\nSnapchat has no public API for reading personal account notifications (snaps, chats, stories). This isn't an n8n limitation — no automation tool can do this without violating Snapchat's Terms of Service.\n\n**Workaround:** none exists short of manual checking."
      }
    },

    {
      "id": "gmail_trigger",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [-100, -420],
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "simple": false,
        "filters": {}
      },
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE_ME", "name": "Gmail account" }
      }
    },
    {
      "id": "set_gmail",
      "name": "Format Gmail",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [140, -420],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "platform", "type": "string", "value": "Gmail" },
            { "id": "2", "name": "title", "type": "string", "value": "={{$json.subject}}" },
            { "id": "3", "name": "message", "type": "string", "value": "={{$json.snippet}}" },
            { "id": "4", "name": "timestamp", "type": "string", "value": "={{$json.internalDate}}" },
            { "id": "5", "name": "link", "type": "string", "value": "={{'https://mail.google.com/mail/u/0/#inbox/' + $json.id}}" }
          ]
        }
      }
    },

    {
      "id": "telegram_trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [-100, -180],
      "parameters": {
        "updates": ["message"]
      },
      "credentials": {
        "telegramApi": { "id": "REPLACE_ME", "name": "Telegram Bot" }
      }
    },
    {
      "id": "set_telegram",
      "name": "Format Telegram",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [140, -180],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "platform", "type": "string", "value": "Telegram" },
            { "id": "2", "name": "title", "type": "string", "value": "={{$json.message.chat.title || $json.message.from.first_name}}" },
            { "id": "3", "name": "message", "type": "string", "value": "={{$json.message.text}}" },
            { "id": "4", "name": "timestamp", "type": "string", "value": "={{$json.message.date}}" },
            { "id": "5", "name": "link", "type": "string", "value": "" }
          ]
        }
      }
    },

    {
      "id": "schedule_twitter",
      "name": "Every 5 Min (Twitter)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-100, 60],
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      }
    },
    {
      "id": "http_twitter",
      "name": "Get Twitter Mentions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [140, 60],
      "parameters": {
        "url": "https://api.twitter.com/2/tweets/search/recent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "twitterOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "query", "value": "@YOUR_HANDLE" },
            { "name": "tweet.fields", "value": "created_at,author_id" }
          ]
        },
        "options": {}
      },
      "credentials": {
        "twitterOAuth2Api": { "id": "REPLACE_ME", "name": "Twitter/X API" }
      },
      "notes": "Requires a paid X API tier (Basic or higher) — free tier no longer supports search."
    },
    {
      "id": "split_twitter",
      "name": "Split Tweets",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [340, 60],
      "parameters": {
        "fieldToSplitOut": "data"
      }
    },
    {
      "id": "set_twitter",
      "name": "Format Twitter",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [540, 60],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "platform", "type": "string", "value": "Twitter/X" },
            { "id": "2", "name": "title", "type": "string", "value": "New mention" },
            { "id": "3", "name": "message", "type": "string", "value": "={{$json.text}}" },
            { "id": "4", "name": "timestamp", "type": "string", "value": "={{$json.created_at}}" },
            { "id": "5", "name": "link", "type": "string", "value": "={{'https://twitter.com/i/web/status/' + $json.id}}" }
          ]
        }
      }
    },

    {
      "id": "schedule_instagram",
      "name": "Every 15 Min (Instagram)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-100, 320],
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] }
      }
    },
    {
      "id": "http_instagram",
      "name": "Get Instagram Mentions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [140, 320],
      "parameters": {
        "url": "=https://graph.facebook.com/v19.0/YOUR_IG_BUSINESS_ID/tags",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "fields", "value": "caption,timestamp,permalink" }
          ]
        },
        "options": {}
      },
      "credentials": {
        "facebookGraphApi": { "id": "REPLACE_ME", "name": "Instagram Graph API" }
      },
      "notes": "Only works for Instagram Business/Creator accounts linked to a Facebook Page, with an app that has passed Meta review."
    },
    {
      "id": "split_instagram",
      "name": "Split IG Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [340, 320],
      "parameters": {
        "fieldToSplitOut": "data"
      }
    },
    {
      "id": "set_instagram",
      "name": "Format Instagram",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [540, 320],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "platform", "type": "string", "value": "Instagram" },
            { "id": "2", "name": "title", "type": "string", "value": "New tag/mention" },
            { "id": "3", "name": "message", "type": "string", "value": "={{$json.caption}}" },
            { "id": "4", "name": "timestamp", "type": "string", "value": "={{$json.timestamp}}" },
            { "id": "5", "name": "link", "type": "string", "value": "={{$json.permalink}}" }
          ]
        }
      }
    },

    {
      "id": "merge",
      "name": "Merge All Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [780, -180],
      "parameters": {
        "mode": "append",
        "numberInputs": 4
      }
    },

    {
      "id": "telegram_send",
      "name": "Send Unified Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1020, -180],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "REPLACE_WITH_YOUR_CHAT_ID",
        "text": "=🔔 *{{$json.platform}}*\n{{$json.title}}\n{{$json.message}}\n{{$json.link}}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "credentials": {
        "telegramApi": { "id": "REPLACE_ME", "name": "Telegram Bot" }
      }
    }
  ],
  "connections": {
    "Gmail Trigger": { "main": [[{ "node": "Format Gmail", "type": "main", "index": 0 }]] },
    "Format Gmail": { "main": [[{ "node": "Merge All Sources", "type": "main", "index": 0 }]] },

    "Telegram Trigger": { "main": [[{ "node": "Format Telegram", "type": "main", "index": 0 }]] },
    "Format Telegram": { "main": [[{ "node": "Merge All Sources", "type": "main", "index": 1 }]] },

    "Every 5 Min (Twitter)": { "main": [[{ "node": "Get Twitter Mentions", "type": "main", "index": 0 }]] },
    "Get Twitter Mentions": { "main": [[{ "node": "Split Tweets", "type": "main", "index": 0 }]] },
    "Split Tweets": { "main": [[{ "node": "Format Twitter", "type": "main", "index": 0 }]] },
    "Format Twitter": { "main": [[{ "node": "Merge All Sources", "type": "main", "index": 2 }]] },

    "Every 15 Min (Instagram)": { "main": [[{ "node": "Get Instagram Mentions", "type": "main", "index": 0 }]] },
    "Get Instagram Mentions": { "main": [[{ "node": "Split IG Items", "type": "main", "index": 0 }]] },
    "Split IG Items": { "main": [[{ "node": "Format Instagram", "type": "main", "index": 0 }]] },
    "Format Instagram": { "main": [[{ "node": "Merge All Sources", "type": "main", "index": 3 }]] },

    "Merge All Sources": { "main": [[{ "node": "Send Unified Alert", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
